---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { pathFor, titleFor, descriptionFor, imageFor, sourceUrl, langFor } from '../lib/page-meta';

interface Props { page: CollectionEntry<'pages'> }
const { page } = Astro.props;
const { Content } = await render(page);
const body = page.body ?? '';
---
<Base
  lang={langFor(page.id)}
  path={pathFor(page.id)}
  title={titleFor(body)}
  description={descriptionFor(body)}
  image={imageFor(page.id, body)}
  source={sourceUrl(page.id)}
  home={page.id === 'README.md'}
>
  <Content />
</Base>
